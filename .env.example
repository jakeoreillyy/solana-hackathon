# Copy to .env (never commit .env)
SOLANA_CLUSTER=devnet
# Faucet rate-limited? Use a free local network instead:
#   SOLANA_RPC_URL=http://127.0.0.1:8899   then run `npm run validator` (Windows: `npm run validator:win`)
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Frontend uses mocks by default so UI work continues if chain is down.
# Set to false once ownership + settlement are wired.
NEXT_PUBLIC_USE_MOCKS=true
# Demo wallets: generate with `npm run wallets` (writes to .keys/, gitignored)
SELLER_KEYPAIR_PATH=.keys/seller.json
BUYER_KEYPAIR_PATH=.keys/buyer.json
ATTESTER_KEYPAIR_PATH=.keys/attester.json
# Public key of the attester (read-only path, safe for the browser). Printed by npm run wallets.
ATTESTER_PUBKEY=
NEXT_PUBLIC_ATTESTER_PUBKEY=
